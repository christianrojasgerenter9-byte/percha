rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    function money(v) {
      return v is int && v > 0 && v <= 200000;
    }

    // ---- Armario privado -------------------------------------------------
    // Solo el dueño lee y escribe lo suyo. Nadie más, nunca.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      // Ganchos y saldo: solo el dueño, y dentro de topes razonables.
      allow write: if signedIn() && request.auth.uid == uid
        && (!('points' in request.resource.data)
            || (request.resource.data.points is int
                && request.resource.data.points >= 0
                && request.resource.data.points <= 200000))
        && (!('credit' in request.resource.data)
            || (request.resource.data.credit is int
                && request.resource.data.credit >= 0
                && request.resource.data.credit <= 5000))
        // Horario y racha del bazar: horas cortas, historial acotado.
        && (!('wakeAt' in request.resource.data) || str(request.resource.data.wakeAt, 5))
        && (!('bazarAt' in request.resource.data) || str(request.resource.data.bazarAt, 5))
        && (!('bzDays' in request.resource.data)
            || (request.resource.data.bzDays is list
                && request.resource.data.bzDays.size() <= 60));

      match /garments/{gid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['id', 'cat', 'name'])
          && str(request.resource.data.id, 60)
          && str(request.resource.data.cat, 20)
          && str(request.resource.data.name, 80)
          && (!('photo' in request.resource.data)
              || request.resource.data.photo == null
              || str(request.resource.data.photo, 700000))
          && (!('desc' in request.resource.data)
              || str(request.resource.data.desc, 400));
      }
    }

    // ---- Bazar público ---------------------------------------------------
    // Cualquiera con cuenta puede mirar; solo el dueño publica y borra lo suyo.
    match /market/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.sellerUid
        && request.resource.data.keys().hasAll(['id', 'sellerUid', 'price', 'name', 'cat'])
        && money(request.resource.data.price)
        && str(request.resource.data.name, 80)
        && str(request.resource.data.cat, 20)
        && str(request.resource.data.size, 20)
        && str(request.resource.data.cond, 30)
        && (!('desc' in request.resource.data) || str(request.resource.data.desc, 400))
        && (!('wa' in request.resource.data) || str(request.resource.data.wa, 15))
        && request.resource.data.sold == false;

      // El vendedor puede editar lo suyo, pero nunca cambiar de dueño.
      allow update: if signedIn()
        && request.auth.uid == resource.data.sellerUid
        && request.resource.data.sellerUid == resource.data.sellerUid
        && money(request.resource.data.price)
        && str(request.resource.data.name, 80);

      // Vistas y guardados: cualquiera con cuenta puede sumar, y NADA más.
      // Solo se permiten esas dos llaves, así que no se puede tocar precio ni dueño.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'favs'])
        && request.resource.data.views is int
        && request.resource.data.views >= 0
        && request.resource.data.views <= 1000000;

      allow delete: if signedIn() && request.auth.uid == resource.data.sellerUid;
    }

    // ---- Reputación de vendedores ---------------------------------------
    // Un documento por vendedor: n calificaciones, sum de estrellas.
    // Todos leen el promedio; quien califica solo puede sumar una de 1 a 5.
    match /sellers/{uid} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['n', 'sum'])
        && request.resource.data.n == 1
        && request.resource.data.sum >= 1
        && request.resource.data.sum <= 5;

      allow update: if signedIn()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n', 'sum'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.sum >= resource.data.sum + 1
        && request.resource.data.sum <= resource.data.sum + 5;
    }

    // ---- Ofertas ---------------------------------------------------------
    // Privadas entre comprador y vendedor.
    match /offers/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.buyerUid
         || request.auth.uid == resource.data.sellerUid);

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.buyerUid
        && request.resource.data.buyerUid != request.resource.data.sellerUid
        && money(request.resource.data.offer)
        && money(request.resource.data.ask)
        && str(request.resource.data.name, 80)
        && str(request.resource.data.note, 140)
        && request.resource.data.status == 'pendiente';

      // Solo el vendedor responde, y solo puede tocar el estado.
      allow update: if signedIn()
        && request.auth.uid == resource.data.sellerUid
        && request.resource.data.buyerUid == resource.data.buyerUid
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.offer == resource.data.offer
        && request.resource.data.status in ['aceptada', 'rechazada'];

      allow delete: if false;
    }

    // ---- Pedidos (pago con comprobante) ---------------------------------
    // Solo comprador y vendedor ven el pedido y su comprobante.
    match /orders/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.buyerUid
         || request.auth.uid == resource.data.sellerUid);

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.buyerUid
        && request.resource.data.buyerUid != request.resource.data.sellerUid
        && money(request.resource.data.price)
        && str(request.resource.data.name, 80)
        && str(request.resource.data.ref, 30)
        && str(request.resource.data.buyer, 60)
        && str(request.resource.data.buyerWa, 10)
        && request.resource.data.buyerWa.size() == 10
        && (!('receipt' in request.resource.data)
            || request.resource.data.receipt == null
            || str(request.resource.data.receipt, 700000))
        && request.resource.data.status == 'pagado';

      // Ambas partes confirman; nadie cambia dueños ni montos.
      allow update: if signedIn()
        && (request.auth.uid == resource.data.buyerUid
         || request.auth.uid == resource.data.sellerUid)
        && request.resource.data.buyerUid == resource.data.buyerUid
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.price == resource.data.price
        && request.resource.data.net == resource.data.net;

      allow delete: if false;
    }

    // ---- Base de clientes (interna) -------------------------------------
    // Cada comprador escribe solo su ficha. Nadie más la lee desde la app;
    // Percha la consulta desde la consola de Firebase.
    match /customers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && str(request.resource.data.name, 60)
        && str(request.resource.data.wa, 10)
        && request.resource.data.orders is int
        && request.resource.data.spent is int
        && (!('zone' in request.resource.data) || str(request.resource.data.zone, 60))
        && (!('promos' in request.resource.data) || request.resource.data.promos is bool)
        && request.resource.data.size() <= 40;
      allow delete: if false;
    }

    // ---- Tiendas (ej. naturista) ----------------------------------------
    function storeAdmins(sid) {
      return get(/databases/$(database)/documents/stores/$(sid)).data.admins;
    }
    function isStoreAdmin(sid) {
      return signedIn() && request.auth.token.email.lower() in storeAdmins(sid);
    }
    match /stores/{sid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.admins is list
        && request.auth.token.email.lower() in request.resource.data.admins
        && str(request.resource.data.name, 80);
      allow update: if isStoreAdmin(sid)
        && request.resource.data.admins is list
        && request.resource.data.admins.size() >= 1
        && request.resource.data.admins.size() <= 10
        && str(request.resource.data.name, 80)
        && (!('clabe' in request.resource.data) || str(request.resource.data.clabe, 18));
      allow delete: if false;

      match /products/{pid} {
        allow read: if signedIn();
        allow write: if isStoreAdmin(sid)
          && (request.method == 'delete'
              || (str(request.resource.data.name, 80)
                  && money(request.resource.data.price)
                  && (!('photo' in request.resource.data) || request.resource.data.photo == null || str(request.resource.data.photo, 400000))));
      }
    }

    // Pedidos apartados en tienda: el comprador crea, los admins de la tienda atienden.
    match /storeOrders/{id} {
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.buyerUid
        && request.resource.data.status == 'nuevo'
        && money(request.resource.data.total)
        && request.resource.data.admins == storeAdmins(request.resource.data.storeId)
        && str(request.resource.data.name, 60)
        && str(request.resource.data.phone, 10);
      allow read: if signedIn()
        && (request.auth.uid == resource.data.buyerUid
         || request.auth.token.email.lower() in resource.data.admins);
      allow update: if signedIn()
        && request.auth.token.email.lower() in resource.data.admins
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['nuevo', 'pagado', 'listo', 'entregado'];
      allow delete: if false;
    }

    // ---- Todo lo demás: cerrado -----------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
